---
const currentYear = new Date().getFullYear();
---

<footer class="bg-cream-dark border-t border-rose/20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-2">
        <span class="text-xl font-bold font-serif text-walnut">Annie's Journal</span>
        <p class="mt-3 text-walnut-muted max-w-md">
          Your daily health companion. Track symptoms naturally with voice, spot patterns, and take control of your health journey.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="font-semibold text-walnut mb-4">Product</h4>
        <ul class="space-y-2">
          <li><a href="/features" class="text-walnut-muted hover:text-sage transition-colors">Features</a></li>
          <li><a href="/how-it-works" class="text-walnut-muted hover:text-sage transition-colors">How It Works</a></li>
          <li><a href="https://app.anniesjournal.com" class="text-walnut-muted hover:text-sage transition-colors">Open App</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-walnut mb-4">Company</h4>
        <ul class="space-y-2">
          <li><a href="/about" class="text-walnut-muted hover:text-sage transition-colors">About</a></li>
          <li><a href="/privacy" class="text-walnut-muted hover:text-sage transition-colors">Privacy</a></li>
          <li><a href="https://github.com/lawrab/annies-health-journal" class="text-walnut-muted hover:text-sage transition-colors">GitHub</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 pt-8 border-t border-rose/20 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-walnut-muted text-sm">
        &copy; {currentYear} Annie's Journal. Made with love for Annie.
      </p>
      <p class="text-walnut-muted text-sm">
        Open source under <a href="https://github.com/lawrab/annies-health-journal/blob/main/LICENSE" class="text-sage hover:underline">AGPL-3.0</a>
      </p>
    </div>
  </div>
</footer>
