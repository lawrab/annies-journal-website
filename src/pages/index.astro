---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Annie's Journal - Your Daily Health Companion">
  <Header />

  <main class="pt-16">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-cream to-cream-dark">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
        <div class="text-center max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-sage/10 border border-sage/30 rounded-full mb-6">
            <span class="w-2 h-2 bg-sage rounded-full animate-pulse"></span>
            <span class="text-sm font-medium text-sage">Alpha — Free while we build (paid plans coming)</span>
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-walnut leading-tight">
            Some days are harder to explain than others.
          </h1>
          <p class="mt-8 text-xl sm:text-2xl text-walnut-muted max-w-2xl mx-auto leading-relaxed">
            Annie's Journal listens when you need to talk through how you're feeling — no forms, no fuss. Just your voice.
          </p>
          <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://app.anniesjournal.com"
              class="btn-cta text-lg px-8 py-4"
            >
              Start Your Journal
            </a>
            <a
              href="/how-it-works"
              class="btn-secondary text-lg px-8 py-4"
            >
              See How It Works
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem Section - Conversational Prose -->
    <section class="py-20 sm:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose-walnut">
          <p class="text-xl sm:text-2xl text-walnut-muted leading-relaxed">
            You know the feeling. You walk into the appointment you've been waiting weeks for, and suddenly your mind goes blank.
          </p>
          <p class="mt-6 text-xl sm:text-2xl text-walnut leading-relaxed">
            When did that symptom start? Was it getting better or worse? What were you doing when it happened?
          </p>
          <p class="mt-6 text-lg text-walnut-muted leading-relaxed">
            Paper journals get lost. Rigid apps feel like work. And the details that matter most are the first to fade from memory.
          </p>
        </div>
      </div>
    </section>

    <!-- Solution Section -->
    <section class="py-20 sm:py-24 bg-mist/40">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-walnut">
            Just talk. We'll handle the rest.
          </h2>
          <p class="mt-6 text-lg text-walnut-muted leading-relaxed">
            Record a quick voice check-in whenever you need to. Speak naturally about how you're feeling, and we'll help you make sense of it over time.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Voice Check-ins -->
          <div class="card">
            <div class="w-14 h-14 bg-rose/50 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-walnut mb-3">Voice Check-ins</h3>
            <p class="text-walnut-muted leading-relaxed">
              Speak naturally about how you're feeling. "I woke up with a headache again, maybe a 6 out of 10..."
            </p>
          </div>

          <!-- Pattern Recognition -->
          <div class="card">
            <div class="w-14 h-14 bg-sage-light/50 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-walnut mb-3">Patterns Over Time</h3>
            <p class="text-walnut-muted leading-relaxed">
              See connections between your activities and symptoms. Discover what triggers your worst days — and what helps.
            </p>
          </div>

          <!-- Doctor Reports -->
          <div class="card">
            <div class="w-14 h-14 bg-rose/50 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-walnut mb-3">Ready for Appointments</h3>
            <p class="text-walnut-muted leading-relaxed">
              Generate clear summaries for medical visits. Show your doctor exactly what's been happening, with the details that matter.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Roadmap Section -->
    <section class="py-20 sm:py-24">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-sm font-medium text-sage uppercase tracking-wider mb-4">
            Roadmap
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-walnut">
            What we're building
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <!-- Now -->
          <div class="card border-2 border-sage/30">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 bg-sage rounded-full"></span>
              <span class="text-sm font-semibold text-sage uppercase tracking-wider">Now</span>
            </div>
            <h3 class="text-xl font-semibold text-walnut mb-3">Alpha Release</h3>
            <ul class="space-y-2 text-walnut-muted">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-sage mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                <span>Voice check-ins</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-sage mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                <span>Symptom tracking</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-sage mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                <span>Pattern insights</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-sage mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                <span>Appointment summaries</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-sage mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                <span>Passwordless login</span>
              </li>
            </ul>
          </div>

          <!-- Up Next -->
          <div class="card">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 bg-terracotta rounded-full"></span>
              <span class="text-sm font-semibold text-terracotta uppercase tracking-wider">Up Next</span>
            </div>
            <h3 class="text-xl font-semibold text-walnut mb-3">Easier Access</h3>
            <ul class="space-y-2 text-walnut-muted">
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 mt-1 flex-shrink-0 text-center text-xs">○</span>
                <span>Mobile optimizations</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 mt-1 flex-shrink-0 text-center text-xs">○</span>
                <span>Edit past check-ins</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 mt-1 flex-shrink-0 text-center text-xs">○</span>
                <span>Offline mode</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 mt-1 flex-shrink-0 text-center text-xs">○</span>
                <span>Search & filter</span>
              </li>
            </ul>
          </div>

          <!-- Later -->
          <div class="card">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 bg-walnut-muted rounded-full"></span>
              <span class="text-sm font-semibold text-walnut-muted uppercase tracking-wider">Later</span>
            </div>
            <h3 class="text-xl font-semibold text-walnut mb-3">More Power</h3>
            <ul class="space-y-2 text-walnut-muted">
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 mt-1 flex-shrink-0 text-center text-xs">○</span>
                <span>Weekly email digest</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 mt-1 flex-shrink-0 text-center text-xs">○</span>
                <span>Doctor sharing links</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 mt-1 flex-shrink-0 text-center text-xs">○</span>
                <span>Medication tracking</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 mt-1 flex-shrink-0 text-center text-xs">○</span>
                <span>Wearable integrations</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Personal Story Section -->
    <section class="py-20 sm:py-24 bg-mist/40">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm font-medium text-sage uppercase tracking-wider mb-4">
          Built for Annie, shared with you
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold text-walnut mb-6">
          This started with one person's health journey.
        </h2>
        <p class="text-lg text-walnut-muted leading-relaxed max-w-2xl mx-auto">
          Annie's Journal was created to help someone with complex, undiagnosed symptoms track what was happening and communicate better with their doctors. It helped. Now it's yours too.
        </p>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 sm:py-24 bg-terracotta">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">
          Ready to start tracking?
        </h2>
        <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto leading-relaxed">
          Free during alpha, private, and takes just 30 seconds a day. Your health story deserves to be heard.
        </p>
        <a
          href="https://app.anniesjournal.com"
          class="inline-flex px-8 py-4 bg-white text-terracotta font-semibold rounded-xl hover:bg-cream transition-colors text-lg shadow-soft"
        >
          Start Your Journal
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
