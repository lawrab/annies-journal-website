---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Features - Annie's Journal"
  description="Voice-first symptom tracking, pattern recognition, and appointment preparation - designed for difficult days."
>
  <Header />

  <main class="pt-16">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-cream to-cream-dark">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
        <div class="text-center">
          <h1 class="text-4xl sm:text-5xl font-bold text-walnut leading-tight">
            Simple enough for your hardest days.
          </h1>
          <p class="mt-6 text-xl text-walnut-muted max-w-2xl mx-auto leading-relaxed">
            When brain fog makes it hard to remember yesterday, when your hands won't cooperate, when you just need to be done — Annie's Journal is there.
          </p>
        </div>
      </div>
    </section>

    <!-- Voice Check-ins Feature -->
    <section class="py-16 sm:py-24">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-rose/50 rounded-full mb-4">
              <span class="text-sm font-medium text-walnut">Core Feature</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-bold text-walnut mb-6">
              Voice check-ins
            </h2>
            <p class="text-lg text-walnut-muted leading-relaxed mb-4">
              No typing. No tapping through menus. Just talk about how you're feeling, and we'll listen.
            </p>
            <p class="text-lg text-walnut leading-relaxed">
              "I woke up with that headache again, maybe a 6 out of 10. My hands are stiff this morning but better than yesterday. Felt a bit dizzy when I stood up..."
            </p>
            <p class="mt-6 text-walnut-muted italic">
              Designed for the days when even holding a phone feels like too much.
            </p>
          </div>
          <div class="flex justify-center">
            <div class="w-64 h-64 bg-rose/30 rounded-full flex items-center justify-center">
              <div class="w-20 h-20 bg-terracotta rounded-full flex items-center justify-center recording-pulse">
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Story Quote Break -->
    <section class="py-12 bg-mist/40">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-lg text-walnut leading-relaxed italic">
          "Annie needed a way to track things herself. Something simple enough to use on bad days. Something that didn't need her to type or navigate menus when her hands aren't working."
        </p>
      </div>
    </section>

    <!-- Pattern Recognition Feature -->
    <section class="py-16 sm:py-24">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="order-2 md:order-1 flex justify-center">
            <div class="relative">
              <div class="w-72 h-48 bg-white rounded-2xl shadow-card p-6">
                <div class="space-y-3">
                  <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full bg-sage"></div>
                    <div class="h-2 bg-sage-light/50 rounded w-24"></div>
                    <span class="text-xs text-walnut-muted">Mon</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full bg-terracotta"></div>
                    <div class="h-2 bg-terracotta-light/50 rounded w-32"></div>
                    <span class="text-xs text-walnut-muted">Tue</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full bg-terracotta"></div>
                    <div class="h-2 bg-terracotta-light/50 rounded w-36"></div>
                    <span class="text-xs text-walnut-muted">Wed</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full bg-sage"></div>
                    <div class="h-2 bg-sage-light/50 rounded w-20"></div>
                    <span class="text-xs text-walnut-muted">Thu</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full bg-sage"></div>
                    <div class="h-2 bg-sage-light/50 rounded w-16"></div>
                    <span class="text-xs text-walnut-muted">Fri</span>
                  </div>
                </div>
              </div>
              <div class="absolute -bottom-4 -right-4 bg-honey-light/30 rounded-xl px-4 py-2">
                <span class="text-sm text-walnut font-medium">Pattern detected</span>
              </div>
            </div>
          </div>
          <div class="order-1 md:order-2">
            <h2 class="text-3xl sm:text-4xl font-bold text-walnut mb-6">
              Patterns over time
            </h2>
            <p class="text-lg text-walnut-muted leading-relaxed mb-4">
              Symptoms that change hour to hour are hard to track. Annie's Journal helps you see the bigger picture.
            </p>
            <ul class="space-y-3 text-walnut">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-sage mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Track how symptoms change over days, weeks, months</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-sage mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Spot connections between activities and how you feel</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-sage mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Discover what triggers your worst days — and what helps</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Appointment Prep Feature -->
    <section class="py-16 sm:py-24 bg-mist/40">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl sm:text-4xl font-bold text-walnut mb-6">
              Ready for your appointment
            </h2>
            <p class="text-lg text-walnut-muted leading-relaxed mb-4">
              You've waited weeks for this appointment. You get 15 minutes. Make them count.
            </p>
            <p class="text-lg text-walnut leading-relaxed mb-6">
              Generate clear summaries of what's been happening. Show your doctor the timeline, the patterns, the details that matter — without relying on your memory in the moment.
            </p>
            <p class="text-walnut-muted italic">
              No more telling your story from the beginning to every new doctor.
            </p>
          </div>
          <div class="flex justify-center">
            <div class="w-72 bg-white rounded-2xl shadow-card p-6">
              <div class="flex items-center gap-2 mb-4">
                <svg class="w-5 h-5 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span class="text-sm font-medium text-walnut">Appointment Summary</span>
              </div>
              <div class="space-y-3 text-sm">
                <div class="pb-3 border-b border-rose/20">
                  <p class="text-walnut-muted">Last 30 days</p>
                  <p class="text-walnut font-medium">12 check-ins recorded</p>
                </div>
                <div class="pb-3 border-b border-rose/20">
                  <p class="text-walnut-muted">Primary symptoms</p>
                  <p class="text-walnut">Joint pain, fatigue, headaches</p>
                </div>
                <div>
                  <p class="text-walnut-muted">Notable pattern</p>
                  <p class="text-walnut">Symptoms worse on days after poor sleep</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Additional Features Grid -->
    <section class="py-16 sm:py-24">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-walnut mb-12 text-center">
          Everything else you need
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Privacy First -->
          <div class="card">
            <div class="w-12 h-12 bg-sage-light/50 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-walnut mb-2">Privacy first</h3>
            <p class="text-walnut-muted">
              Your health data stays yours. We don't sell it or use it for advertising.
            </p>
          </div>

          <!-- Export Data -->
          <div class="card">
            <div class="w-12 h-12 bg-rose/50 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-walnut mb-2">Export anytime</h3>
            <p class="text-walnut-muted">
              Download all your data whenever you want. It's yours.
            </p>
          </div>

          <!-- Open Source -->
          <div class="card">
            <div class="w-12 h-12 bg-mist rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-walnut" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-walnut mb-2">Open source</h3>
            <p class="text-walnut-muted">
              Fully transparent. See exactly how your data is handled.
            </p>
          </div>

          <!-- Account Required -->
          <div class="card">
            <div class="w-12 h-12 bg-sage-light/50 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-walnut mb-2">Simple account</h3>
            <p class="text-walnut-muted">
              Create an account to keep your journal secure and synced across devices.
            </p>
          </div>

          <!-- Free During Alpha -->
          <div class="card">
            <div class="w-12 h-12 bg-rose/50 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-walnut mb-2">Free during alpha</h3>
            <p class="text-walnut-muted">
              We're in alpha testing — use everything for free while we build. Pricing will come later.
            </p>
          </div>

          <!-- Delete Your Data -->
          <div class="card">
            <div class="w-12 h-12 bg-mist rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-walnut" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-walnut mb-2">Delete anytime</h3>
            <p class="text-walnut-muted">
              Your data, your choice. Request deletion and we'll remove everything completely.
            </p>
          </div>

          <!-- Quick Check-ins -->
          <div class="card">
            <div class="w-12 h-12 bg-mist rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-walnut" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-walnut mb-2">30 seconds a day</h3>
            <p class="text-walnut-muted">
              A quick voice note is all it takes. Do more when you can, less when you can't.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 sm:py-24 bg-terracotta">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">
          Ready to start tracking?
        </h2>
        <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto leading-relaxed">
          Your health story deserves to be heard. Start your journal today.
        </p>
        <a
          href="https://app.anniesjournal.com"
          class="inline-flex px-8 py-4 bg-white text-terracotta font-semibold rounded-xl hover:bg-cream transition-colors text-lg shadow-soft"
        >
          Start Your Journal
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
